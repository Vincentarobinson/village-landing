# Supabase project (Settings → API)
# The anon key is safe for this use: RLS only allows inserts, never reads.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Resend (email) — all optional; emails are skipped if unset
RESEND_API_KEY=re_YOUR_KEY
RESEND_FROM="Vincent from Village <vincent@yourdomain.com>"
RESEND_AUDIENCE_PARENTS=
RESEND_AUDIENCE_SITTERS=
RESEND_AUDIENCE_MOMS=
